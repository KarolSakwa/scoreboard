{
    "name": "worldcup/scoreboard",
    "description": "In-memory Football World Cup scoreboard",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.91",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "WorldCup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WorldCup\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    }
}
